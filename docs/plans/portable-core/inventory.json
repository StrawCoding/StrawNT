{
  "track": "A+3 + wine-pivot (NTW0) + legacy native-pe + game-compat",
  "stage": "ntw0-contract-legal",
  "description": "Portable Core crate→artifact inventory. Product default execution_backend=wine / proton-ge (powered by Wine) since 2026-08-07. Native PE (pe0–pe7) and Game Compat (gx0–gx5) evidence retained as legacy/archive. Not a full Windows compatibility claim; anti-cheat matrix is honest (no ranked play claim).",
  "prefix_env": "STRAWNT_PREFIX",
  "execution_backend": "wine",
  "execution_backend_legacy": "native",
  "engine": "proton-ge",
  "wine_ban_policy": "lift_ban",
  "build": {
    "prefix_script": "components/packaging/portable/build-prefix.sh",
    "appimage_script": "components/packaging/portable/build-appimage.sh",
    "flatpak_script": "components/packaging/portable/build-flatpak.sh",
    "make_target": "portable-prefix",
    "make_appimage": "portable-appimage",
    "make_flatpak": "portable-flatpak",
    "smoke": "tests/portable/smoke-prefix.sh",
    "smoke_appimage": "tests/portable/smoke-appimage.sh",
    "smoke_flatpak": "tests/portable/smoke-flatpak.sh",
    "smoke_matrix": "tests/portable/smoke-matrix.sh",
    "closeout": "tests/portable/closeout.sh",
    "pe_closeout": "tests/portable/pe-closeout.sh",
    "gx_closeout": "tests/portable/gx-closeout.sh",
    "evidence": "tests/portable/output/smoke-prefix.json",
    "evidence_appimage": "tests/portable/output/smoke-appimage.json",
    "evidence_flatpak": "tests/portable/output/smoke-flatpak.json",
    "evidence_matrix": "tests/portable/output/matrix.json",
    "evidence_closeout": "tests/portable/output/closeout.json",
    "evidence_pe_closeout": "tests/portable/output/pe-closeout.json",
    "evidence_gx_closeout": "tests/portable/output/gx-closeout.json",
    "evidence_pe0": "tests/portable/output/pe0-remove-wine.json",
    "evidence_pe1": "tests/portable/output/pe-real-exec.json",
    "evidence_pe2": "tests/portable/output/pe-console.json",
    "evidence_pe3": "tests/portable/output/pe-gui.json",
    "evidence_pe4": "tests/portable/output/pe-installer.json",
    "evidence_pe5": "tests/portable/output/pe-desktop-click.json",
    "evidence_pe6": "tests/portable/output/pe-golden.json",
    "evidence_gx0": "tests/portable/output/gx-graphics.json",
    "evidence_gx1": "tests/portable/output/gx-audio-input.json",
    "evidence_gx2": "tests/portable/output/gx-light-games.json",
    "evidence_gx3": "tests/portable/output/gx-launchers.json",
    "evidence_gx4": "tests/portable/output/gx-anticheat.json",
    "sha256sums": "tests/portable/output/SHA256SUMS",
    "artifacts_index": "docs/plans/portable-core/artifacts.json",
    "user_guide": "docs/plans/portable-core/USER-GUIDE.md",
    "pe_closeout_report": "docs/plans/portable-core/pe-closeout-report.md",
    "gx_closeout_report": "docs/plans/portable-core/gx-closeout-report.md",
    "flatpak_manifest": "components/packaging/portable/flatpak/org.strawwu.Core.yaml",
    "flatpak_sandbox_notes": "components/packaging/portable/flatpak/SANDBOX-NOTES.md"
  },
  "components": {
    "runtime": {
      "crate": "strawwu-runtime",
      "path": "components/strawwu-runtime",
      "kind": "rust-lib",
      "artifact": "libstrawwu_runtime.rlib",
      "linked_into": ["strawwu"],
      "role": "SubsystemSession orchestrator, process graph, workload scheduling",
      "shared_libs_host": ["libc.so.6"],
      "packaging": {
        "prefix": "lib/",
        "appimage": "usr/lib/strawwu/",
        "flatpak": "lib/strawwu/"
      }
    },
    "nt": {
      "crate": "strawwu-nt",
      "path": "components/strawwu-nt",
      "kind": "rust-lib",
      "artifact": "libstrawwu_nt.rlib",
      "linked_into": ["strawwu"],
      "role": "NT/PE loader, CPU exec loop, Win32 ABI (native execution_backend)",
      "shared_libs_host": ["libc.so.6"],
      "packaging": {
        "prefix": "lib/",
        "appimage": "usr/lib/strawwu/",
        "flatpak": "lib/strawwu/"
      }
    },
    "launcher": {
      "crate": "strawwu-launcher",
      "path": "components/strawwu-launcher",
      "kind": "rust-bin",
      "artifact": "strawwu",
      "role": "PE/ELF dispatch CLI entrypoint (default backend=native)",
      "shared_libs_host": ["libc.so.6", "libgcc_s.so.1", "libm.so.6", "libpthread.so.0", "libdl.so.2"],
      "packaging": {
        "prefix": "bin/strawwu",
        "appimage": "usr/bin/strawwu",
        "flatpak": "bin/strawwu"
      }
    },
    "cli": {
      "crate": "strawwu-cli",
      "path": "components/strawwu-cli",
      "kind": "rust-lib",
      "artifact": "libstrawwu_cli.rlib",
      "linked_into": ["strawwu"],
      "role": "status/devices/mfp CLI surfaces used by launcher",
      "shared_libs_host": ["libc.so.6"],
      "packaging": {
        "prefix": "lib/",
        "appimage": "usr/lib/strawwu/",
        "flatpak": "lib/strawwu/"
      }
    },
    "graphics": {
      "crate": "strawwu-graphics",
      "path": "components/strawwu-graphics",
      "kind": "rust-lib",
      "artifact": "libstrawwu_graphics.rlib",
      "linked_into": ["strawwu"],
      "role": "graphics bridge (DXGI/D3D11/Vulkan/OpenGL present path)",
      "shared_libs_host": ["libc.so.6", "libvulkan.so.1", "libGL.so.1"],
      "notes": "Host GPU ICD may remain PARTIAL under Flatpak sandbox",
      "packaging": {
        "prefix": "lib/",
        "appimage": "usr/lib/strawwu/",
        "flatpak": "lib/strawwu/"
      }
    },
    "audio": {
      "crate": "strawwu-audio",
      "path": "components/strawwu-audio",
      "kind": "rust-lib",
      "artifact": "libstrawwu_audio.rlib",
      "linked_into": ["strawwu"],
      "role": "audio / input bridge (WASAPI→PipeWire/ALSA/Pulse/File, XInput path, gx1 evidence)",
      "shared_libs_host": ["libc.so.6", "libpulse.so.0", "libasound.so.2"],
      "notes": "Pulse/PipeWire host access may require Flatpak --socket=pulseaudio",
      "packaging": {
        "prefix": "lib/",
        "appimage": "usr/lib/strawwu/",
        "flatpak": "lib/strawwu/"
      }
    },
    "hub": {
      "crate": "strawwu-hub",
      "path": "hub",
      "kind": "electron-app",
      "artifact": "strawwu-hub",
      "role": "System settings / subsystem status UI (optional in core prefix)",
      "shared_libs_host": ["libgtk-3.so.0", "libnss3.so", "libX11.so.6"],
      "notes": "Optional for minimal CLI-only prefix; AppImage/Flatpak may ship separately",
      "packaging": {
        "prefix": "opt/strawwu-hub/",
        "appimage": "optional",
        "flatpak": "optional"
      }
    }
  },
  "support_crates": {
    "bridge": {
      "crate": "strawwu-bridge",
      "path": "components/strawwu-bridge",
      "linked_into": ["strawwu"]
    },
    "app_registry": {
      "crate": "strawwu-app-registry",
      "path": "components/strawwu-app-registry",
      "linked_into": ["strawwu"]
    },
    "device_proxy": {
      "crate": "strawwu-device-proxy",
      "path": "components/strawwu-device-proxy",
      "linked_into": ["strawwu"]
    }
  },
  "packaging_targets": {
    "prefix": "components/packaging/portable/prefix",
    "appimage": "components/packaging/portable/appimage",
    "flatpak": "components/packaging/portable/flatpak"
  },
  "exclusions": [
    "Silent rebrand of Wine as self-made PE (must label powered by Wine)",
    "WinBox/winbox naming",
    "ISO/os-image/Plymouth/Calamares/kernel/desktop session",
    "full Windows compatibility claims",
    "anti-cheat ranked play / 排位可用 claims",
    "NOTE(historical): pre-NTW0 'Wine/Proton forbidden / native only' hard contract — retired 2026-08-07"
  ]
}
