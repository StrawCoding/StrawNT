{
  "schema": "strawwu-ci-baseline/v1",
  "wave": "W7-CI2+CI3+CI4",
  "version": "0.7.1.3",
  "plan": "docs/plans/strawwu-ci-build-plan.md",
  "workflows": {
    "ci": ".github/workflows/ci.yml",
    "nightly": ".github/workflows/nightly.yml",
    "release": ".github/workflows/release.yml",
    "kernel_build": ".github/workflows/kernel-build.yml"
  },
  "make_targets": [
    "preflight",
    "dev-iso",
    "release-iso",
    "test-wincompat",
    "validate-calamares-preflight",
    "test-ci-baseline",
    "test-ci-nightly",
    "generate-release-manifest",
    "release-sign",
    "test-perf-baseline",
    "test-legal-trademark",
    "test-perf-legal-gate",
    "test-perf-boot-regression",
    "measure-boot-time",
    "kernel-build",
    "test-ci-kernel-selfhosted",
    "test-phase2"
  ],
  "phases": {
    "CI0": {
      "status": "complete",
      "artifact": "ci-baseline.json"
    },
    "CI1": {
      "status": "deferred",
      "note": "rootfs reproducibility hash gate"
    },
    "CI2": {
      "status": "complete",
      "trigger": "cron 03:00 UTC main",
      "workflow": "nightly.yml",
      "iso_mode": "dev-iso",
      "signed": "sha256",
      "artifact_retention_days": 30
    },
    "CI3": {
      "status": "complete",
      "workflow": "ci.yml",
      "pr_gate": [
        "preflight",
        "test-wincompat",
        "validate-calamares-preflight",
        "check-version-bump"
      ]
    },
    "CI4": {
      "status": "complete",
      "runner": "self-hosted",
      "workflows": [
        "nightly.yml",
        "release.yml"
      ],
      "gpg_import": "scripts/ci-import-gpg.sh",
      "secrets": [
        "STRAWWU_GPG_PRIVATE_KEY",
        "STRAWWU_GPG_KEY_ID",
        "APT_DISPATCH_TOKEN"
      ]
    },
    "Q6": {
      "status": "complete",
      "workflow": "kernel-build.yml",
      "runner": "self-hosted",
      "trigger": "cron 02:00 UTC Sunday + workflow_dispatch",
      "artifact": "linux-image-strawwu .deb + SHA256SUMS + kernel-manifest.json",
      "script": "scripts/ci-kernel-artifact.sh"
    }
  },
  "workflow_files": [
    "ci.yml",
    "kernel-build.yml",
    "nightly.yml",
    "release.yml"
  ],
  "scripts": {
    "ci_import_gpg": "scripts/ci-import-gpg.sh",
    "release_sign": "scripts/release-sign.sh",
    "manifest_generator": "scripts/generate-release-manifest.sh",
    "ci_kernel_artifact": "scripts/ci-kernel-artifact.sh"
  },
  "wave0_gaps": [
    "CI1 rootfs reproducibility hash gate",
    "production archive signing key deployment on runner"
  ],
  "gaps_closed": [
    "CI2 nightly pipeline (cron → dev-iso → SHA256 → manifest draft)",
    "CI3 PR gate (preflight + wincompat + calamares + version bump)",
    "CI4 self-hosted runner wiring (nightly + release + GPG secrets)",
    "Q6 kernel-build.yml self-hosted workflow (Phase 2 kernel CI)",
    "PERF1 ISO size gate in release CI (w7-perf-legal-gate)",
    "LEG4 release compliance gate in CI (w7-perf-legal-gate)",
    "PERF2 boot-time regression gate (post-perf-boot-regression)"
  ],
  "deferred": [
    "CI1 rootfs reproducibility hash gate",
    "production archive signing key deployment on runner"
  ],
  "perf_legal_gates": {
    "PERF1": {
      "status": "complete",
      "target": "test-perf-baseline",
      "strict_env": "STRAWWU_PERF_GATE=strict",
      "workflow": "release.yml"
    },
    "LEG4": {
      "status": "complete",
      "target": "test-legal-trademark",
      "workflows": [
        "ci.yml",
        "release.yml"
      ]
    }
  },
  "perf_boot_gates": {
    "PERF2": {
      "status": "complete",
      "target": "test-perf-boot-regression",
      "measure": "measure-boot-time",
      "advisory_env": "STRAWWU_PERF2_GATE=advisory",
      "strict_env": "STRAWWU_PERF2_GATE=strict",
      "workflow": "nightly.yml"
    }
  }
}
