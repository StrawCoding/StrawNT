# Copy to tests/dev-vm/vm.env and adjust.
# Backend: qemu (local qcow2) or ssh (installed StrawWU host).

STRAWWU_DEV_VM_BACKEND=qemu

# --- qemu backend ---
STRAWWU_DEV_VM_QEMU_NAME=strawwu-dev
STRAWWU_DEV_VM_QEMU_DISK=/mnt/data/code/project/StrawCoding/StrawWU/tests/dev-vm/strawwu-dev.qcow2
STRAWWU_DEV_VM_QEMU_SNAPSHOT=dev-clean
STRAWWU_DEV_VM_QEMU_SSH_PORT=2222
STRAWWU_DEV_VM_QEMU_MEMORY=4096
# Base image: install once from release ISO, then snapshot.
STRAWWU_DEV_VM_QEMU_BASE_IMAGE=

# --- ssh backend (installed system) ---
STRAWWU_DEV_VM_SSH_HOST=strawwu-dev.local
STRAWWU_DEV_VM_SSH_USER=ubuntu
STRAWWU_DEV_VM_SSH_PORT=22
STRAWWU_DEV_VM_SSH_KEY=

# Paths synced from repo → VM (space-separated globs relative to repo root)
STRAWWU_DEV_VM_SYNC_PATHS="components/strawwu-runtime components/strawwu-bridge os-image/config/branding"

# Services restarted after sync (space-separated unit names)
STRAWWU_DEV_VM_RESTART_SERVICES="strawwu-runtime.service"

# Test command run inside VM after sync (non-zero = FAIL)
STRAWWU_DEV_VM_TEST_CMD="systemctl is-active --quiet gdm.service && echo STRAWWU_DEV_VM_OK"
