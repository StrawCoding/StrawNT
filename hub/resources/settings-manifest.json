{
  "schema": "strawwu-hub-settings/v1",
  "wave": "W4-F3",
  "role": "system-settings-center",
  "desktop": {
    "categories": ["Settings", "System"],
    "keywords": ["settings", "preferences", "configure", "strawwu", "hub"]
  },
  "panels": [
    { "id": "status", "group": "system" },
    { "id": "logs", "group": "system" },
    { "id": "updates", "group": "system" },
    { "id": "backup", "group": "system" },
    { "id": "software-sources", "group": "system" },
    { "id": "apps", "group": "applications" },
    { "id": "flathub", "group": "applications" },
    { "id": "drivers", "group": "system" },
    { "id": "devices", "group": "system" },
    { "id": "language", "group": "personalization" },
    { "id": "wincompat", "group": "compatibility" },
    { "id": "system", "group": "shortcuts" },
    { "id": "about", "group": "info" }
  ],
  "legal": {
    "privacy": "/usr/share/strawwu/legal/privacy.html",
    "eula": "/usr/share/strawwu/legal/eula.html",
    "third_party": "/usr/share/strawwu/legal/third-party.html"
  },
  "bug_report": {
    "gtk": "strawwu-bug-report-gtk",
    "cli": "strawwu-bug-report"
  },
  "compat_matrix": {
    "installed": "/usr/share/strawwu/compat-matrix.json",
    "dev": "components/tests/wincompat/output/compat-matrix.json"
  },
  "app_registry": {
    "installed": "/var/lib/strawwu/app-registry.json",
    "dev": "components/strawwu-app-registry/tests/fixtures/sample-registry.json",
    "cli": "strawwu-app-registry",
    "cli_dev": "components/target/debug/strawwu-app-registry"
  },
  "flathub": {
    "remote": "flathub",
    "api": "https://flathub.org/api/v2",
    "flatpak_cli": "/usr/bin/flatpak",
    "fixture": "hub/tests/fixtures/flathub-catalog.json"
  },
  "drivers": {
    "cli": "/usr/bin/strawwu-drivers",
    "cli_dev": "os-image/debs/strawwu-drivers/usr/bin/strawwu-drivers",
    "fixture": "hub/tests/fixtures/drivers-catalog.json",
    "polkit_action": "xyz.wastebase.strawwu.drivers.install",
    "secure_boot_plan": "post-sec-secureboot-route"
  },
  "backup": {
    "cli": "/usr/bin/strawwu-backup",
    "cli_dev": "os-image/debs/strawwu-backup/usr/bin/strawwu-backup",
    "fixture": "hub/tests/fixtures/backup-catalog.json",
    "upgrade_hook": "strawwu-upgrade snapshot",
    "shared_root": "/var/lib/strawwu/backups"
  },
  "software_sources": {
    "cli": "/usr/bin/strawwu-software-sources",
    "cli_dev": "os-image/debs/strawwu-software-sources/usr/bin/strawwu-software-sources",
    "fixture": "hub/tests/fixtures/software-sources-catalog.json",
    "polkit_action": "xyz.wastebase.strawwu.software-sources.toggle",
    "update_notifier": "strawwu-update-notifier"
  },
  "device_proxy": {
    "cli": "/usr/bin/strawwu",
    "cli_dev": "components/target/debug/strawwu",
    "list_command": "devices list --json",
    "fixture": "hub/tests/fixtures/device-proxy-catalog.json",
    "udev_rules": "/usr/lib/udev/rules.d/99-strawwu-device-proxy.rules"
  },
  "system_shortcuts": [
    { "id": "wifi", "desktop": "gnome-wifi-panel.desktop" },
    { "id": "network", "desktop": "gnome-network-panel.desktop" },
    { "id": "display", "desktop": "gnome-display-panel.desktop" },
    { "id": "sound", "desktop": "gnome-sound-panel.desktop" },
    { "id": "power", "desktop": "gnome-power-panel.desktop" },
    { "id": "region", "desktop": "gnome-region-panel.desktop" },
    { "id": "users", "desktop": "gnome-user-accounts-panel.desktop" }
  ]
}
