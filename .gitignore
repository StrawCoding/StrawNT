os-image/work/
os-image/fork-base/snapshots/
os-image/fork-base/snapshots/*.tar.zst
os-image/output/cache/
os-image/output/*.iso
tests/boot/output/serial-*.log
tests/boot/output/qemu-*.log
tests/boot/output/*.log
tests/install-e2e/output/
tests/release-manifest/output/
calamares-settings-ubuntu-common_*.deb
*.partial

# dev-vm local config and disks
tests/dev-vm/vm.env
tests/dev-vm/*.qcow2

# kernel build artifacts (never commit source tree or build logs)
kernel/build/
kernel/build.log
kernel/output/*.deb
**/__pycache__/
**/*.pyc

# deb build outputs are rebuilt from source (build-deb.sh) — never commit them.
# They previously bloated the repo with hundreds of per-version binaries.
os-image/debs/*/output/
os-image/output/apt-repo/
os-image/output/apt-fork-repo/

# preflight test outputs are regenerated every run (they even contain throwaway
# GPG keypairs) — must never be committed.
tests/apt-repo/output/
tests/ci/output/

# upstream technical references (~370MB; refresh via docs/technical-references/scripts/)
docs/technical-references/upstream/

# Rust/Cargo build artifacts
components/target/
components/target
components/packaging/output/
packaging/output/

# Portable Core built prefix binaries (rebuild via make portable-prefix)
components/packaging/portable/prefix/bin/
components/packaging/portable/prefix/lib/
components/packaging/portable/prefix/opt/
components/packaging/portable/prefix/var/
components/packaging/portable/prefix/share/strawwu/
components/packaging/portable/prefix/share/doc/
components/packaging/portable/prefix/share/applications/
components/packaging/portable/prefix/share/mime/

# Portable Core AppImage / bundle artifacts (rebuild via make portable-appimage)
components/packaging/portable/appimage/dist/
components/packaging/portable/appimage/.tools/

# Portable Core Flatpak build artifacts (rebuild via make portable-flatpak)
components/packaging/portable/flatpak/staged/
components/packaging/portable/flatpak/.build/
components/packaging/portable/flatpak/.flatpak-builder/
components/packaging/portable/flatpak/repo/
components/packaging/portable/flatpak/dist/
