#!/usr/bin/env python3
"""StrawWU update notifier CLI — replaces Ubuntu update-notifier."""
from __future__ import annotations

import argparse
import importlib.util
import sys
from pathlib import Path

_CORE = Path(__file__).resolve().parent.parent / "lib/strawwu-update-notifier/core.py"
_spec = importlib.util.spec_from_file_location("strawwu_update_notifier_core", _CORE)
_mod = importlib.util.module_from_spec(_spec)
assert _spec.loader is not None
_spec.loader.exec_module(_mod)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="strawwu-update-notifier",
        description="StrawWU update checks and pre-upgrade backup reminders.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Do not show GUI; print actions only",
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("check", help="Check for upgradable packages and log result")
    sub.add_parser("notify", help="Notify user when updates are available")
    sub.add_parser("pre-upgrade", help="Show backup reminder before upgrades")
    sub.add_parser("show-backup-copy", help="Print backup reminder strings")

    args = parser.parse_args(argv)
    if args.dry_run:
        import os

        os.environ["STRAWWU_UPDATE_NOTIFIER_DRY_RUN"] = "1"

    if args.command in (None, "notify"):
        return _mod.cmd_notify()
    if args.command == "check":
        count = _mod.check_updates()
        print(f"upgradable={count}")
        return 0 if count >= 0 else 1
    if args.command == "pre-upgrade":
        return _mod.cmd_pre_upgrade()
    if args.command == "show-backup-copy":
        copy = _mod.load_copy()
        strings = _mod.locale_strings(copy)
        loc = _mod.pick_locale(copy)
        print(f"locale={loc}")
        for key, val in strings.items():
            print(f"{key}={val!r}")
        return 0

    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
