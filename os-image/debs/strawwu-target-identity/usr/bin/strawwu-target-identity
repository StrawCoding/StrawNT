#!/usr/bin/env python3
"""StrawWU target identity CLI — Calamares chroot GRUB/Plymouth branding."""
from __future__ import annotations

import argparse
import importlib.util
import sys
from pathlib import Path

_CORE = Path(__file__).resolve().parent.parent / "lib" / "strawwu-target-identity" / "core.py"
_spec = importlib.util.spec_from_file_location("strawwu_target_identity_core", _CORE)
_mod = importlib.util.module_from_spec(_spec)
assert _spec.loader is not None
_spec.loader.exec_module(_mod)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="strawwu-target-identity",
        description="Apply StrawWU GRUB/Plymouth branding on installed target.",
    )
    parser.add_argument(
        "--calamares-chroot",
        action="store_true",
        help="Invoked by Calamares shellprocess inside target chroot",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Log actions without modifying the system",
    )
    parser.add_argument(
        "--skip-initramfs",
        action="store_true",
        help="Skip update-initramfs (postinst / fast path)",
    )
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("apply", help="Apply target identity branding (default)")
    sub.add_parser("version", help="Print version")

    args = parser.parse_args(argv)
    if args.command == "version":
        return _mod.cmd_version()

    if args.command in (None, "apply") or args.calamares_chroot:
        return _mod.run_target_identity(
            skip_initramfs=args.skip_initramfs,
            dry_run=args.dry_run,
        )

    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
