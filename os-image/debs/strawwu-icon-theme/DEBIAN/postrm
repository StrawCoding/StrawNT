#!/bin/sh
# postrm — refresh the hicolor icon cache after our icons are removed so stale
# cache entries do not linger on package removal.
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
    fi
fi
exit 0
