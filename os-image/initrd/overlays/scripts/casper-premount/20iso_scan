#!/bin/sh
# StrawWU overlay — iso-scan/filename= loopback boot (replaces upstream 20iso_scan).
PREREQ=""

prereqs() {
	echo "$PREREQ"
}

case $1 in
prereqs)
	prereqs
	exit 0
	;;
esac

. /scripts/casper-functions
. /scripts/casper-helpers

iso_path=
for x in $(cat /proc/cmdline); do
	case ${x} in
	iso-scan/filename=*)
		iso_path=${x#iso-scan/filename=}
		;;
	esac
done

if [ -z "${iso_path}" ]; then
	exit 0
fi

if find_path "${iso_path}" /isodevice rw; then
	echo "LIVEMEDIA=${FOUNDPATH}" >> /conf/param.conf
	if [ -f "${FOUNDPATH}" ]; then
		echo "LIVEMEDIA_OFFSET=0" >> /conf/param.conf
	fi
	exit 0
fi

panic "
StrawWU could not find the ISO at ${iso_path}
Check iso-scan/filename= and that the storage device is connected.
"
