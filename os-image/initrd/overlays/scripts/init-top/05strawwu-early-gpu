#!/bin/sh
# Load physical GPU DRM before Plymouth (casper early only ships virtio/bochs modules).
# early2 has .ko.zst payloads but no full modules.dep — use explicit insmod paths.
# PCI-aware: only load the driver matching detected hardware (avoid early panic).
PREREQ="udev"

prereqs()
{
	echo "${PREREQ}"
}

case ${1} in
prereqs)
	prereqs
	exit 0
	;;
esac

KVER="$(uname -r)"
MODROOT="/usr/lib/modules/${KVER}/kernel"

load_mod() {
	stem="$1"
	# shellcheck disable=SC2044
	for ko in $(find "${MODROOT}" -name "${stem}.ko*" 2>/dev/null); do
		[ -f "${ko}" ] || continue
		insmod "${ko}" 2>/dev/null && return 0
	done
	modprobe -q -b "${stem}" 2>/dev/null || true
}

detect_gpu_driver() {
	for vendor in /sys/bus/pci/devices/*/vendor; do
		[ -f "${vendor}" ] || continue
		case "$(cat "${vendor}" 2>/dev/null)" in
		0x8086) echo i915; return ;;
		0x1002|0x1022) echo amdgpu; return ;;
		0x10de) echo nouveau; return ;;
		0x1002) echo radeon; return ;;
		esac
	done
	echo simpledrm
}

gpu_drv="$(detect_gpu_driver)"

# Shared DRM helpers; load only what the detected driver needs.
common_helpers="drm_display_helper drm_ttm_helper drm_exec drm_buddy \
	drm_suballoc_helper drm_panel_backlight_quirks gpu-sched \
	cec i2c-algo-bit i2c-core"

case "${gpu_drv}" in
i915)
	for drv in ${common_helpers} i915 simpledrm; do
		load_mod "${drv}"
	done
	;;
amdgpu)
	for drv in ${common_helpers} amdgpu simpledrm; do
		load_mod "${drv}"
	done
	;;
nouveau)
	for drv in ${common_helpers} nouveau simpledrm; do
		load_mod "${drv}"
	done
	;;
radeon)
	for drv in ${common_helpers} radeon simpledrm; do
		load_mod "${drv}"
	done
	;;
*)
	load_mod simpledrm
	;;
esac

if command -v udevadm >/dev/null 2>&1; then
	udevadm settle 2>/dev/null || true
fi

exit 0
