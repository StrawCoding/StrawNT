[org.gnome.desktop.interface]
gtk-theme='StrawWU-Dark'
icon-theme='Yaru-prussiangreen-dark'
cursor-theme='Yaru'
color-scheme='prefer-dark'
accent-color='teal'
font-name='Ubuntu 11'
document-font-name='Sans 11'
monospace-font-name='Ubuntu Mono 13'
clock-show-weekday=true

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/strawwu/strawwu-wallpaper-light.png'
picture-uri-dark='file:///usr/share/backgrounds/strawwu/strawwu-wallpaper-dark.png'
picture-options='zoom'
primary-color='#0A0E14'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/strawwu/strawwu-wallpaper-dark.png'
picture-options='zoom'
primary-color='#0A0E14'
lock-delay=uint32 300

[org.gnome.login-screen]
logo='/usr/share/plymouth/themes/strawwu-boot/logo.png'

[org.gnome.shell]
welcome-dialog-last-shown-version='99.0'
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Settings.desktop', 'firefox_firefox.desktop']

[org.gnome.shell.extensions.dash-to-dock]
dash-max-icon-size=48
dock-position='BOTTOM'
extend-height=false
show-mounts=false

[org.gnome.shell.extensions.ding]
show-home=false

[org.gnome.desktop.wm.preferences]
button-layout='close,minimize,maximize:'
titlebar-font='Ubuntu Bold 11'

[org.gnome.desktop.sound]
theme-name='Yaru'

[org.gnome.desktop.privacy]
report-technical-problems=false

[org.gnome.mutter]
center-new-windows=true
